FROM node:20.10.0
WORKDIR /app

# Accept build arguments
ARG NODE_ENV=production

# Set environment variables for Next.js build
ENV NODE_ENV=$NODE_ENV

COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps
COPY frontend/ .
RUN npm run build
EXPOSE 8080
CMD ["npm", "start", "--", "-p", "8080"]